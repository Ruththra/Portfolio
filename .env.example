# Required PostgreSQL connection for content, users, and sessions.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Per application instance. Keep this within your database provider's limits.
DATABASE_POOL_MAX=5

# Used only by `pnpm admin:seed`. Never commit real values.
ADMIN_SEED_EMAIL=owner@example.com
ADMIN_SEED_PASSWORD=replace-with-a-long-random-password

# Optional durable media uploads through Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# Private résumé storage. The bucket is created automatically on first upload.
# Keep the service-role key server-only and never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUME_BUCKET=resumes
SUPABASE_MEDIA_BUCKET=media

# Optional email delivery. All three are required in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional Cloudflare Turnstile. Configure both together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
